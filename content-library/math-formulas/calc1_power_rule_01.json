{
  "template_id": "calc1_power_rule_01",
  "topic": "Calculus 1 — Power Rule",
  "formula_string": "Differentiate: f(x) = {coeff}x^{power}",
  "variables": {
    "coeff": "random_int_range(2, 12)",
    "power": "random_int_range(3, 8)",
    "new_coeff": "coeff * power",
    "new_power": "power - 1"
  },
  "ideal_solution_steps": [
    "Bring the exponent {power} down in front to multiply the coefficient {coeff}.",
    "The new coefficient becomes {coeff} × {power} = {new_coeff}.",
    "Subtract 1 from the original power: {power} − 1 = {new_power}.",
    "Write the result in final form."
  ],
  "answer_format": "f'(x) = {new_coeff}x^{new_power}"
}
